{
  "name": "ioiti-ui",
  "version": "0.2.0",
  "private": true,
  "description": "IOITI's design system: React components, design tokens and an application shell for Tailwind CSS 4, made from WATA's admin interface and EasyUI.",
  "license": "MIT",
  "author": "IOITI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IOITI/ioiti-ui.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/styles/styles.css",
      "default": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "default": "./dist/react-router/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./design.css": "./dist/styles/design.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./theme.css": "./dist/styles/theme.css",
    "./accents.css": "./dist/styles/accents.css",
    "./glass.css": "./dist/styles/glass.css",
    "./theme.js": "./dist/theme.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/theme.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "framer-motion": "^13.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
