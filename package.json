{
  "name": "ioiti-ui",
  "version": "0.4.5",
  "private": true,
  "description": "IOITI's design system: React components, design tokens and an application shell for Tailwind CSS 4, made from WATA's admin interface and EasyUI.",
  "license": "MIT",
  "author": "IOITI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IOITI/ioiti-ui.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/styles/styles.css",
      "default": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "default": "./dist/react-router/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./design.css": "./dist/styles/design.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./theme.css": "./dist/styles/theme.css",
    "./accents.css": "./dist/styles/accents.css",
    "./glass.css": "./dist/styles/glass.css",
    "./motion.css": "./dist/styles/motion.css",
    "./theme.js": "./dist/theme.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/theme.js"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.vite.json --noEmit && tsc -p tsconfig.test.json && tsc -p gallery/tsconfig.json",
    "lint": "oxlint && oxlint -c .oxlintrc.copies.json src/components/ui src/lib/chart-primitives.tsx src/lib/dashboard-chart-utils.ts && node scripts/check-source.mjs",
    "test": "vitest run",
    "gallery": "vite --config gallery/vite.config.ts",
    "build:gallery": "vite build --config gallery/vite.config.ts --mode dist",
    "check:package": "node scripts/check-package.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "framer-motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "framer-motion": "^13.5.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
