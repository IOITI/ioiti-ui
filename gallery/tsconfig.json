{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "ioiti-ui": [
        "../src/index.ts"
      ],
      "ioiti-ui/react-router": [
        "../src/react-router/index.ts"
      ],
      "ioiti-ui/code": [
        "../src/code/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "aliases.ts"
  ]
}
